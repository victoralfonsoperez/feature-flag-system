{
  "name": "feature-flag-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @feature-flags/api dev & pnpm --filter @feature-flags/dashboard dev & wait",
    "build": "pnpm -r build",
    "test": "docker compose -f docker-compose.test.yml up -d --wait && pnpm -r test ; docker compose -f docker-compose.test.yml down",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "lodash@<=4.17.23": ">=4.18.0",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "vite@<=6.4.1": ">=6.4.2",
      "vite@>=6.0.0 <=6.4.1": ">=6.4.2",
      "postcss@<8.5.10": ">=8.5.10",
      "fastify@>=5.3.2 <=5.8.4": ">=5.8.5",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.56.1"
  }
}
